---
/**
 * Framework / tool logo drawn like the organisation logos (Logo.astro): a
 * single-colour silhouette (CSS mask filled with currentColor) that takes the
 * brand colour when the surrounding chip is hovered. Decorative: the chip
 * text names the tool, so the logo is aria-hidden.
 *
 * Sources: Simple Icons (CC0; colours in simple-icons.json), Azure and OpenAI
 * marks from Wikimedia Commons. Only tools listed in the CV are shown (see
 * CLAUDE.md). Trademarks belong to their owners.
 */
import meta from '../assets/logos/tech/simple-icons.json';

const files = import.meta.glob<string>('../assets/logos/tech/*.svg', { query: '?raw', import: 'default', eager: true });

export type TechName = keyof typeof meta | 'azure' | 'openai';

interface Props {
  name: TechName;
  /** Rendered height in rem. */
  height?: number;
  class?: string;
}

const { name, height = 1, class: cls } = Astro.props;

let raw = files[`../assets/logos/tech/${name}.svg`];
if (!raw) throw new Error(`TechLogo: missing src/assets/logos/tech/${name}.svg`);

// The OpenAI file is the full wordmark: keep only the symbol (its last path).
if (name === 'openai') {
  const paths = raw.match(/<path\b[^>]*\/>/g) ?? [];
  raw = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="2 0 316 320">${paths[paths.length - 1]}</svg>`;
}

const vb = raw.match(/viewBox="([^"]+)"/)?.[1].split(/[\s,]+/).map(Number) ?? [0, 0, 24, 24];
const ratio = vb[2] / vb[3];

const brands: Record<string, string | undefined> = {
  ...Object.fromEntries(Object.entries(meta).map(([k, v]) => [k, v.hex])),
  azure: '#0078D4',
  openai: undefined,
};
const brand = brands[name];

// Very dark brand colours (NumPy, pandas) would vanish on the dark theme.
const luminance = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
  const [r, g, b] = c.map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const brandDark = brand && luminance(brand) >= 0.05 ? brand : 'currentColor';

const uri = `data:image/svg+xml,${encodeURIComponent(raw)}`;
const style = [
  `--mask:url("${uri}")`,
  `--brand:${brand ?? 'currentColor'}`,
  `--brand-dark:${brandDark}`,
  `height:${height}rem`,
  `width:${(height * ratio).toFixed(3)}rem`,
].join(';');
---

<span class:list={['tech-logo', cls]} aria-hidden="true" style={style}></span>

<style>
  .tech-logo {
    display: inline-block;
    flex: none;
    background-color: currentColor;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
    transition: background-color 220ms ease;
  }

  @media (hover: hover) {
    :global(.tech-chip:hover) > .tech-logo {
      background-color: var(--brand);
    }

    :global(:root[data-theme='dark'] .tech-chip:hover) > .tech-logo {
      background-color: var(--brand-dark);
    }
  }

  @media (hover: hover) and (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light']) .tech-chip:hover) > .tech-logo {
      background-color: var(--brand-dark);
    }
  }
</style>
