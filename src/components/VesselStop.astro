---
/**
 * One stop of the Experience vessel (see Experience.astro for the layout and
 * motion). Renders its branches recursively with Astro.self.
 */
import Logo from './Logo.astro';
import type { Stop } from '../data/career';
import { type Lang, enIfSame, pick, t } from '../i18n/ui';

interface Props {
  stop: Stop;
  lang: Lang;
  branch?: boolean;
}

const { stop, lang, branch = false } = Astro.props;
const title = pick(stop.title, lang);
const titleLang = enIfSame(stop.title, lang);
// Mixed Italian title starting with an English job title: mark that part lang="en".
const enPart = lang !== 'en' && !titleLang && stop.enPrefix && title.startsWith(stop.enPrefix) ? stop.enPrefix : '';
---

<li class:list={['stop', { 'stop--branch': branch }]} data-kind={stop.kind}>
  <div class="stop__row" data-stop={stop.id} data-reveal>
    {
      branch && (
        <svg class="branch" viewBox="0 0 48 40" preserveAspectRatio="none" aria-hidden="true">
          <path d="M0 0C0 24 24 16 48 40" pathLength="1" vector-effect="non-scaling-stroke" />
        </svg>
      )
    }
    <span class="stop__when num">{pick(stop.when, lang)}</span>
    <span class="stop__node" aria-hidden="true"></span>
    <div class="stop__body">
      {
        stop.logos && (
          <p class="org-logos">
            {stop.logos.map((l) => (
              <Logo name={l} height={1.5} />
            ))}
          </p>
        )
      }
      <h3 class="stop__title" lang={titleLang}>
        {enPart ? (
          <>
            <span lang="en">{enPart}</span>
            {title.slice(enPart.length)}
          </>
        ) : (
          title
        )}
      </h3>
      {stop.summary && <p class="stop__line">{pick(stop.summary, lang)}</p>}
      <p class="stop__meta">
        {stop.org}
        {stop.place && <span> · {pick(stop.place, lang)}</span>}
      </p>
      {stop.note && <p class="stop__note">{pick(stop.note, lang)}</p>}
      {
        stop.points && (
          <details class="stop__more disclosure" open={stop.open}>
            <summary>
              {t(lang, 'details')}
              <span class="visually-hidden" lang={titleLang}>
                : {title}
              </span>
              <svg class="chev" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <ul class="points">
              {stop.points.map((pt, i) => (
                <li style={`--i:${i}`}>{pick(pt, lang)}</li>
              ))}
            </ul>
          </details>
        )
      }
    </div>
  </div>
  {
    stop.branches && (
      <ol class="branches" role="list">
        {stop.branches.map((b) => (
          <Astro.self stop={b} lang={lang} branch />
        ))}
      </ol>
    )
  }
</li>

<style>
  .stop {
    list-style: none;
    --node-c: var(--artery);
  }

  .stop[data-kind='edu'] {
    --node-c: var(--vein);
  }

  .branches {
    list-style: none;
    padding: 0;
  }

  .stop__row {
    position: relative;
    display: grid;
    grid-template-columns: var(--when-w) var(--node-w) minmax(0, 1fr);
    column-gap: var(--col-gap);
    padding-block: var(--space-m) var(--space-l);
    view-timeline: --stop-row;
  }

  .stop--branch > .stop__row {
    grid-template-columns: var(--when-w) calc(var(--node-w) + var(--bx)) minmax(0, 1fr);
    padding-top: var(--space-s);
  }

  /* The root (last trunk stop) hides the trunk below its node. */
  :global(.vessel) > .stop:last-child > .stop__row::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) - 4px);
    width: 8px;
    top: var(--node-top);
    bottom: 0;
    z-index: 1;
    background: var(--plate);
  }

  .stop__when {
    color: var(--graphite);
    font-size: var(--step--1);
    padding-top: 0.2rem;
  }

  .stop__node {
    position: relative;
    z-index: 2;
    justify-self: center;
    width: 1rem;
    height: 1rem;
    margin-top: 0.25rem;
    border-radius: 50%;
    background: var(--plate);
    border: 3px solid var(--node-c);
    transition: border-color 200ms ease;
  }

  .stop--branch > .stop__row > .stop__node {
    justify-self: start;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.35rem;
    margin-left: calc(var(--node-w) / 2 + var(--bx) - 0.375rem);
    border-width: 2px;
  }

  .stop__node::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--node-c);
    opacity: 0;
    pointer-events: none;
  }

  /* Branch: a bifurcation that leaves the trunk and curves to the stop. */
  .branch {
    position: absolute;
    left: var(--rail);
    top: calc(var(--space-s) + 0.35rem + 0.375rem - var(--by));
    width: var(--bx);
    height: var(--by);
    overflow: visible;
    fill: none;
  }

  .branch path {
    stroke: var(--node-c);
    stroke-width: 2px;
    stroke-linecap: round;
  }

  .stop__body > * + * {
    margin-top: var(--space-2xs);
  }

  .org-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    color: var(--graphite);
    margin-bottom: var(--space-xs);
  }

  .stop__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.3;
  }

  .stop--branch .stop__title {
    font-size: var(--step-0);
  }

  .stop__line {
    max-width: 60ch;
  }

  .stop__meta,
  .stop__note {
    color: var(--graphite);
    font-size: var(--step--1);
  }

  /* Details disclosure (animated in Chromium; instant elsewhere). */
  .stop__more {
    margin-top: var(--space-2xs);
  }

  .points {
    padding-left: 1.1em;
    padding-bottom: var(--space-2xs);
    max-width: 60ch;
  }

  .points li + li {
    margin-top: var(--space-2xs);
  }

  .points li::marker {
    color: var(--artery);
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Node lights up the first time its stop is in view: ring colour, then one pulse. */
    :global(:root.js) .stop__row[data-reveal]:not([data-reveal='in']) > .stop__node {
      border-color: var(--rule);
    }

    :global(:root.js) .stop__row[data-reveal='in'] > .stop__node::after {
      animation: node-pulse 600ms var(--ease-out) 200ms both;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .branch path {
        stroke-dasharray: 1;
        animation: branch-draw linear both;
        animation-timeline: --stop-row;
        animation-range: entry 30% cover 40%;
      }
    }
  }

  @keyframes branch-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes node-pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(2.4);
    }
  }

  @media (max-width: 40rem) {
    .stop__row {
      grid-template-columns: var(--node-w) minmax(0, 1fr);
    }

    .stop--branch > .stop__row {
      grid-template-columns: calc(var(--node-w) + var(--bx)) minmax(0, 1fr);
    }

    .stop__when {
      grid-column: 2;
      grid-row: 1;
      padding-top: 0;
    }

    .stop__node {
      grid-column: 1;
      grid-row: 1;
    }

    .stop__body {
      grid-column: 2;
    }
  }
</style>
