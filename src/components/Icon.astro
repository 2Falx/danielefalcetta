---
/**
 * Small icon set. Brand glyphs: GitHub, Google Scholar, ORCID from Simple Icons
 * (CC0); LinkedIn from Bootstrap Icons (MIT). Others drawn here.
 * Icons are decorative: the surrounding link or button carries the text.
 */
import brand from './brand-paths.json';

export type IconName = 'linkedin' | 'github' | 'scholar' | 'orcid' | 'mail' | 'download' | 'home';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: cls } = Astro.props;

const linkedin =
  'M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z';
---

{
  name === 'linkedin' && (
    <svg class={cls} viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
      <path d={linkedin} />
    </svg>
  )
}
{
  (name === 'github' || name === 'scholar' || name === 'orcid') && (
    <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
      <path d={brand[name]} />
    </svg>
  )
}
{
  name === 'mail' && (
    <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <rect x="3" y="5.5" width="18" height="13" rx="2" />
      <path d="m3.8 7 8.2 6 8.2-6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'download' && (
    <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14" />
    </svg>
  )
}
{
  name === 'home' && (
    <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z" />
    </svg>
  )
}
