---
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, asset, pick, route, routeKey, t } from '../i18n/ui';
import { person } from '../data/profile';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Hide from search engines (404). */
  noindex?: boolean;
}

const { lang, title, description = pick(person.description, lang), noindex = false } = Astro.props;
const key = routeKey(Astro.url.pathname);
const fullTitle = title ? `${title} | ${person.name}` : `${person.name}, ${pick(person.role, lang)}`;
const site = Astro.site!;
const canonical = new URL(route(lang, key), site).href;
const alternates = (['en', 'it'] as const).map((l) => ({ lang: l, href: new URL(route(l, key), site).href }));
const ogImage = new URL(asset('og-image.png'), site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: new URL(route('en'), site).href,
  image: new URL(asset('og-image.png'), site).href,
  jobTitle: 'AI Decision Science Consultant',
  description: pick(person.description, lang),
  worksFor: { '@type': 'Organization', name: 'Accenture', url: 'https://www.accenture.com/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Sorbonne Université' },
    { '@type': 'CollegeOrUniversity', name: 'EURECOM' },
    { '@type': 'CollegeOrUniversity', name: 'Politecnico di Torino' },
  ],
  knowsAbout: [
    'Generative AI',
    'Retrieval-Augmented Generation',
    'Intelligent Document Processing',
    'Computer Vision',
    'Machine Learning',
    'Deep Learning',
    'MLOps',
    'Microsoft Azure',
    'Google Cloud',
  ],
  sameAs: [person.links.linkedin, person.links.scholar, person.links.github, person.links.orcid],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
        </>
      )
    }

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={asset('favicons/favicon.ico')} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={asset('favicons/favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={asset('favicons/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('favicons/site.webmanifest')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${pick(person.role, lang)}`} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'it' ? 'en_GB' : 'it_IT'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      // Mark that scripts run, so JS-only states (collapsed menu, pending
      // reveals, pause buttons) never hide content when JavaScript is off.
      document.documentElement.classList.add('js');
      // Apply a saved theme before first paint. Stored only after the visitor
      // presses the theme button; never sent anywhere.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (_) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">{t(lang, 'skip')}</a>
    <Header lang={lang} current={key} notFound={noindex} />
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
