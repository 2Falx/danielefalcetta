---
import Base from '../layouts/Base.astro';
import { route } from '../i18n/ui';
---

<Base lang="en" title="Page not found · Pagina non trovata" noindex>
  <div class="wrap page-head prose">
    <h1>This page does not exist</h1>
    <p>The address may be mistyped, or the page may have moved when the site was rebuilt.</p>
    <p><a class="list-link" href={route('en')}>Go to the home page</a></p>
    <div lang="it" class="not-found__it">
      <h2>Questa pagina non esiste</h2>
      <p>L’indirizzo potrebbe essere sbagliato, oppure la pagina potrebbe essere stata spostata quando il sito è stato rifatto.</p>
      <p><a class="list-link" href={route('it')}>Vai alla home in italiano</a></p>
    </div>
  </div>
</Base>
